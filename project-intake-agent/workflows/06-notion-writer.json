    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    run_id,\n    intake_page_id,\n    project_page_id,\n    status,\n    ai_plan\nFROM project_intake_runs\nWHERE run_id = $1;",
        "options": {
          "queryReplacement": "={{[  $json.run_id]}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        -96
      ],
      "id": "4c822114-8ba2-450c-8f2e-ee42caabb206",
      "name": "Load Writer Context"
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\n\nlet plan = row.ai_plan || {};\n\nif (typeof plan === 'string') {\n  plan = JSON.parse(plan);\n}\n\nfunction cleanText(value) {\n  if (!value) return '';\n  return String(value).trim();\n}\n\nfunction limitText(value, max = 1800) {\n  const text = cleanText(value);\n  return text.length > max ? text.slice(0, max) + '\n[TRUNCATED]' : text;\n}\n\nfunction normalizeProjectStatus(value, fallback = 'Discovery') {\n  const allowed = ['New project', 'Not started', 'Discovery', 'Design', 'Development', 'Testing', 'Production', 'Done'];\n  if (!value) return fallback;\n  const clean = String(value).trim();\n  return allowed.includes(clean) ? clean : fallback;\n}\n\nconst projectDescription = limitText([\n  plan.project_summary ? `Summary:\n${plan.project_summary}` : '',\n  plan.business_problem ? `\nBusiness problem:\n${plan.business_problem}` : '',\n  plan.desired_outcome ? `\nDesired outcome:\n${plan.desired_outcome}` : '',\n  plan.workflow_design ? `\nWorkflow design:\n${plan.workflow_design}` : ''\n].filter(Boolean).join('\n\n'), 1900);\n\nconst projectStatus = normalizeProjectStatus(row.project_status || plan.project_status || row.status || 'Discovery');\n\nreturn [\n  {\n    json: {\n      run_id: row.run_id,\n      intake_page_id: row.intake_page_id,\n      project_page_id: row.project_page_id,\n      ai_plan: plan,\n      project_description: projectDescription,\n      project_status: projectStatus,\n      task_count: Number(plan.task_count || 0)\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -96
      ],
      "id": "6b14722b-077c-4672-a654-ba584cd8b509",
      "name": "Prepare Project Update"
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "update",
        "pageId": {
          "__rl": true,
          "value": "={{ $json.project_page_id }}",
          "mode": "id"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Project Description|rich_text",
              "textContent": "={{ $json.project_description }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        672,
        -96
      ],
      "id": "22357af8-8fe7-44aa-9209-0de4d8381432",
      "name": "Update Notion Project"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    r.run_id,\n    r.intake_page_id,\n    r.project_page_id,\n    COALESCE(\n        jsonb_agg(\n            jsonb_build_object(\n                'id', t.id,\n                'run_id', t.run_id,\n                'project_page_id', t.project_page_id,\n                'task_key', t.task_key,\n                'task_name', t.task_name,\n                'task_description', t.task_description,\n                'task_stage', t.task_stage,\n                'task_status', t.task_status,\n                'priority', t.priority,\n                'effort_level', t.effort_level,\n                'deadline', t.deadline,\n                'task_order', t.task_order\n            )\n            ORDER BY t.task_order NULLS LAST, t.created_at\n        ) FILTER (WHERE t.id IS NOT NULL),\n        '[]'::jsonb\n    ) AS tasks\nFROM project_intake_runs r\nLEFT JOIN project_tasks t\n    ON t.run_id = r.run_id\n   AND t.notion_task_id IS NULL\nWHERE r.run_id = $1\nGROUP BY\n    r.run_id,\n    r.intake_page_id,\n    r.project_page_id;",
        "options": {
          "queryReplacement": "={{[  $('Prepare Project Update').first().json.run_id]}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        896,
        -96
      ],
      "id": "b968b5f0-bfb1-42f9-9756-9afe71c11608",
      "name": "Load Pending Task Rows"
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\n\nlet tasks = row.tasks || [];\n\nif (typeof tasks === \"string\") {\n  tasks = JSON.parse(tasks);\n}\n\nif (!Array.isArray(tasks) || tasks.length === 0) {\n  return [\n    {\n      json: {\n        no_pending_tasks: true,\n        run_id: row.run_id,\n        intake_page_id: row.intake_page_id,\n        project_page_id: row.project_page_id\n      }\n    }\n  ];\n}\n\nreturn tasks.map(task => ({\n  json: {\n    no_pending_tasks: false,\n\n    db_task_id: task.id,\n    run_id: task.run_id,\n    intake_page_id: row.intake_page_id,\n    project_page_id: task.project_page_id,\n\n    task_key: task.task_key,\n    task_name: task.task_name,\n    task_description: task.task_description || \"\",\n    task_stage: task.task_stage || \"Discovery\",\n    task_status: task.task_status || \"Not started\",\n    priority: task.priority || \"Medium\",\n    effort_level: task.effort_level || \"Medium\",\n    deadline: task.deadline || null,\n    task_order: task.task_order || null\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
