    {
      "parameters": {
        "jsCode": "const raw = String($json.project_id || $json.content || $json.output || '').trim();\n\nconst match = raw.match(/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i);\n\nif (!match) {\n  throw new Error(`No valid UUID found in input: ${raw}`);\n}\n\nreturn [\n  {\n    json: {\n      project_id: match[0]\n    }\n  }\n];"
      },
