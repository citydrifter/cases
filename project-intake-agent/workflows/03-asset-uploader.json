{
  "name": "03 - Asset Uploader",
  "nodes": [
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"run_id\": \"a string\",\n  \"intake_page_id\": \"a string\",\n  \"project_page_id\": \"a string\",\n  \"file_name\": \"a string\",\n  \"file_type\": \"a string\",\n  \"mime\": \"a string\",\n  \"source_url\": \"a string\"\n}"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        -96
      ],
      "id": "04361ed2-8c8e-4a27-ae66-b1ead8c0504f",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "const json = $input.first().json || {};\n\nif (!json.run_id) throw new Error(\"Missing run_id\");\nif (!json.project_page_id) throw new Error(\"Missing project_page_id\");\nif (!json.file_name) throw new Error(\"Missing file_name\");\nif (!json.file_type) throw new Error(\"Missing file_type\");\nif (!json.mime) throw new Error(\"Missing mime\");\nif (!json.source_url) throw new Error(\"Missing source_url\");\n\nconst safeFileName = String(json.file_name)\n  .replace(/[^\\w.\\-() ]+/g, \"_\")\n  .trim();\n\nconst storageBucket = \"Docs\";\nconst storagePath = `${json.run_id}/${safeFileName}`;\n\nreturn [\n  {\n    json: {\n      run_id: json.run_id,\n      project_page_id: json.project_page_id,\n      intake_page_id: json.intake_page_id || null,\n\n      file_name: safeFileName,\n      original_file_name: json.file_name,\n      file_type: json.file_type,\n      mime: json.mime,\n      source_url: json.source_url,\n\n      storage_bucket: storageBucket,\n      storage_path: storagePath\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -96
      ],
      "id": "4009cb45-a689-400f-9746-fad9ce0c6e18",
      "name": "Normalize Upload Input"
    },
    {
      "parameters": {
        "resource": "databasePage",
        "databaseId": {
          "__rl": true,
          "value": "YOUR_NOTION_DOCUMENT_HUB_DB_ID",
          "mode": "list",
          "cachedResultName": "Document Hub",
          "cachedResultUrl": "https://notion.so/YOUR_PAGE"
        },
        "title": "={{ $json.file_name }}",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Project Relation|relation",
              "relationValue": [
                "={{ $json.project_page_id }}"
              ]
            },
            {
              "key": "Category|multi_select",
              "multiSelectValue": "={{ $json.file_type === \"screenshot\" ? [\"Screenshot\"] : ($json.file_type === \"sop\" ? [\"SOP\"] : [\"Strategy doc\"]) }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        448,
        -96
      ],
      "id": "dd09fe51-2fc4-4d95-9a9f-2c38f04ea451",
      "name": "Create Document Hub Page"
    },
    {
      "parameters": {
        "url": "={{ $('Normalize Upload Input').item.json.source_url }}",
        "options": {
          "response": {
