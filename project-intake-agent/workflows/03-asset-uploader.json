      ],
      "id": "a0ee8d46-9b48-4fd9-98ac-6310ce59e4e9",
      "name": "Upload Doc to Notion"
    },
    {
      "parameters": {
        "jsCode": "const input = $('Normalize Upload Input').first().json;\nconst documentPage = $('Create Document Hub Page').first().json;\nconst uploadRequest = $('Create Notion Upload Request').first().json;\n\nreturn [\n  {\n    json: {\n      run_id: input.run_id,\n      project_page_id: input.project_page_id,\n      intake_page_id: input.intake_page_id,\n\n      file_name: input.file_name,\n      original_file_name: input.original_file_name,\n      file_type: input.file_type,\n      mime: input.mime,\n      source_url: input.source_url,\n\n      storage_bucket: input.storage_bucket,\n      storage_path: input.storage_path,\n      storage_url: null,\n\n      notion_document_page_id: documentPage.id,\n      notion_file_upload_id: uploadRequest.id,\n\n      upload_status: \"uploaded\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        0
      ],
      "id": "229faad8-d426-439f-8c53-0574a121f19c",
      "name": "Return Upload Metadata"
    }
  ],
