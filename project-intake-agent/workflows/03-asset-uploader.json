    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://YOUR_SUPABASE_PROJECT.supabase.co/storage/v1/object/{{ $('Normalize Upload Input').first().json.storage_bucket }}/{{ $('Normalize Upload Input').first().json.storage_path.urlEncode() }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
