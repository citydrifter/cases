      ],
      "id": "01f72af7-ba48-45b0-8abc-0f502b02da3d",
      "name": "Ingest Doc to Supabase",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.notion.com/v1/pages/{{ $('Create Document Hub Page').item.json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"properties\": {\n    \"File\": {\n      \"type\": \"files\",\n      \"files\": [\n        {\n          \"type\": \"file_upload\",\n          \"file_upload\": {\n            \"id\": \"{{ $('Create Notion Upload Request').first().json.id }}\"\n          },\n          \"name\": \"{{ $('Normalize Upload Input').first().json.file_name }}\"\n        }\n      ]\n    }\n  }\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
