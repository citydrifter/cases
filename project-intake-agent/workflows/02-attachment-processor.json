{
  "name": "02 - Attachment Processor",
  "nodes": [
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\n  \"run_id\": \"string\",\n  \"intake_page_id\": \"string\",\n  \"project_page_id\": \"string\",\n  \"raw_intake\": null\n}"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        736
      ],
      "id": "4933d28c-d7ba-4034-ba2f-5b1b606aff84",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst runId = input.run_id;\nconst intakePageId = input.intake_page_id;\nconst projectPageId = input.project_page_id;\n\nlet intake = input.raw_intake || {};\n\nif (typeof intake === \"string\") {\n  try {\n    intake = JSON.parse(intake);\n  } catch (error) {\n    throw new Error(`raw_intake is not valid JSON: ${error.message}`);\n  }\n}\n\nconst output = [];\n\nfunction detectMime(url) {\n  if (!url) return null;\n\n  const clean = url.split(\"?\")[0].toLowerCase();\n\n  if (clean.endsWith(\".pdf\")) return \"pdf\";\n  if (clean.endsWith(\".docx\")) return \"docx\";\n  if (clean.endsWith(\".png\")) return \"png\";\n  if (clean.endsWith(\".jpg\")) return \"jpg\";\n  if (clean.endsWith(\".jpeg\")) return \"jpeg\";\n  if (clean.endsWith(\".webp\")) return \"webp\";\n\n  return null;\n}\n\nfunction extractFileName(url) {\n  if (!url) return null;\n\n  const clean = url.split(\"?\")[0];\n  const parts = clean.split(\"/\");\n  return decodeURIComponent(parts[parts.length - 1]);\n}\n\nfunction addFiles(urls, sourceCategory) {\n  if (!Array.isArray(urls)) return;\n\n  for (const url of urls) {\n    if (!url) continue;\n\n    const mime = detectMime(url);\n    if (!mime) continue;\n\n    const fileKind = [\"png\", \"jpg\", \"jpeg\", \"webp\"].includes(mime)\n      ? \"screenshot\"\n      : sourceCategory;\n\n    output.push({\n      json: {\n        run_id: runId,\n        intake_page_id: intakePageId,\n        project_page_id: projectPageId,\n        file_name: extractFileName(url),\n        file_type: fileKind,\n        mime,\n        source_url: url,\n        skip_files: false\n      }\n    });\n  }\n}\n\naddFiles(intake[\"Current state SOP (DOCX or PDF files)\"], \"sop\");\naddFiles(intake[\"Existing documentation (DOCX or PDF files)\"], \"documentation\");\naddFiles(intake[\"Screenshots\"], \"screenshot\");\n\nif (output.length === 0) {\n  return [\n    {\n      json: {\n        run_id: runId,\n        intake_page_id: intakePageId,\n        project_page_id: projectPageId,\n        skip_files: true\n      }\n    }\n  ];\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
